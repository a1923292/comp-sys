// Contains a function Fib.fib that calculates and returns the nth Fibonacci number recursively
// n is supplied as an argument

// Put your code here.

function Fib.fib 0

// base case, if n < 2
push argument 0
push constant 2
lt
if-goto BASECASE

// recursive case
// Compute fib(n-1)
push argument 0
push constant 1
sub
call Fib.fib 1     // fib(n-1) result on top of stack
push argument 0
push constant 2
sub
call Fib.fib 1     // fib(n-2) result on top of stack
add                 // fib(n-1) + fib(n-2)
return

// base case: return n
label BASECASE
push argument 0
return