// ArrMax.vm
// Function: ArrMax.arrMax(m, n)
// Returns the largest value in an array of length n
// m = pointer to array, n = number of elements

function ArrMax.arrMax 2
// local 0 = index i
// local 1 = current max

// base of THAT = m
push argument 0
pop pointer 1 // that = array base address

// initialise max = that[0]
push that 0
pop local 1

// initialize i = 1
push constant 1
pop local 0

label LOOP_START
// if i >= n, end loop
push local 0
push argument 1
ge
if-goto LOOP_END

push argument 0
push local 0
add
pop pointer 1
push that 0

// that[i] > max ?
push local 1
gt
if-goto UPDATE_MAX

goto CONTINUE_LOOP

label UPDATE_MAX
// update max = that[i]
push that 0
pop local 1

label CONTINUE_LOOP
push argument 0
pop pointer 1

// i++
push local 0
push constant 1
add
pop local 0

goto LOOP_START

label LOOP_END
push local 1
return
