// Contains a function ArrMax.arrMax that finds and returns the largest element in the array a of length b.
// a & b are both supplied as arguments

// Put your code here.

function ArrMax.arrMax 0

// store array base address in THAT
push argument 0
pop pointer 1

// loop index i = 0
push constant 0
pop local 0 // local 0 = i

// Initialize max = first element (that[0])
push that 0
pop local 1            // local 1 = max

// i = 1
push constant 1
pop local 0

label LOOP_START

// if i >= n, end loop
push local 0
push argument 1
gt
if-goto LOOP_END

// get current element, that[i]
push pointer 1
push local 0
add
pop pointer 1
push that 0

// if arr[i] < max, skip updating max
push local 1
lt                     
if-goto SKIP_UPDATE

// max = arr[i]
push pointer 1
push that 0
pop local 1

label SKIP_UPDATE

push argument 0
pop pointer 1

// i++
push local 0
push constant 1
add
pop local 0

goto LOOP_START

label LOOP_END

push local 1
return